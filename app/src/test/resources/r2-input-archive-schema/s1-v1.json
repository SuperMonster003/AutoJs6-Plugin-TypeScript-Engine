    "manifestPath": "request-manifest.json",
    "payloadDomains": [
      "source",
      "config",
      "package-metadata",
      "package-target-v1",
      "package-target-v2"
    ],
    "sourceRoot": "sources/",
    "configPath": "tsconfig.json",
    "projectPackageMetadataPath": "package.json",
    "dependencyPackageRoot": "packages/",
    "callerDeclarationPathsAllowed": false,
    "manifestIncludedInPayloadInventory": false,
    "exactPhysicalCoverage": "manifest-plus-every-declared-caller-payload-exactly-once"
  },
  "trustedDeclarationDomain": {
    "domain": "declaration",
    "ownership": "signed-plugin-local-distribution",
    "physicallyPresentInCallerArchive": false,
    "injectedAfterCallerArchiveValidation": true,
    "profileFingerprintKey": "declarationProfileFingerprint",
    "exactLocalFileInventoryRequired": true,
    "callerWireIdentityIncludes": [
      "declarationsFingerprint",
      "declarationProfileFingerprint"
    ],
    "locallyDerivedAcceptedAuthorityIncludes": [
      "declarationInventoryFingerprint",
      "declarationFileCount",
      "declarationByteLength"
    ]
  },
  "logicalInventory": {
    "canonicalPrefix": "autojs6.typescript.input-inventory.v1\n",
    "canonicalDomainOrder": [
      "source",
      "declaration",
      "config",
      "package-metadata",
      "package-target-v1",
      "package-target-v2"
    ],
    "callerInventoryIncludes": [
      "source",
      "config",
      "package-metadata",
      "package-target-v1",
      "package-target-v2"
    ],
    "callerInventoryExcludes": [
      "request-manifest-json",
      "declaration",
      "zip-container-bytes"
    ],
    "declarationInventoryIncludes": [
      "declaration"
    ],
    "retainedInventoryIncludes": [
      "source",
      "declaration",
      "config",
      "package-metadata",
      "package-target-v1",
      "package-target-v2"
    ],
    "canonicalRecord": "domain-nul-path-nul-size-nul-lower-sha256-newline",
    "ordering": "canonical-domain-order-then-canonical-path",
    "asciiCaseFoldCollisionPolicy": "fail-closed"
  },
  "hashAuthority": [
    {
      "name": "archiveSha256",
      "coverage": "entire-caller-zip-container",
      "boundBy": "control-plane-bundle",
      "recomputed": true
    },
    {
      "name": "requestManifestSha256",
      "coverage": "exact-request-manifest-bytes",
      "boundBy": "control-plane-bundle",
      "recomputed": true
    },
    {
      "name": "callerInventoryFingerprint",
      "coverage": "all-non-manifest-caller-payload-descriptors",
      "boundBy": "manifest-and-accepted-authority",
      "recomputed": true
    },
    {
      "name": "declarationProfileFingerprint",
      "coverage": "signed-local-selected-declaration-profile",
      "boundBy": "control-plane-and-manifest",
      "recomputed": true
    },
    {
      "name": "declarationInventoryFingerprint",
      "coverage": "exact-injected-declaration-file-inventory",
      "boundBy": "accepted-authority-and-worker-start",
      "recomputed": true
    },
    {
      "name": "retainedInventoryFingerprint",
      "coverage": "caller-payload-plus-injected-declarations",
      "boundBy": "accepted-authority-and-worker-start",
      "recomputed": true
    }
  ],
  "ordinaryQuota": {
    "inputQuotaRevision": 1,
    "maximumFiles": 512,
    "maximumSingleFileBytes": 8388608,
    "maximumTotalBytes": 8388608,
    "comparison": "inclusive",
    "countedDomains": [
      "source",
      "declaration",
      "config",
      "package-metadata",
      "package-target-v1",
      "package-target-v2"
    ],
    "excludedDomains": [
      "request-manifest-json",
      "zip-container-bytes",
      "framing-overhead"
    ],
    "callerQuotaError": "ERR_AUTOJS6_TYPESCRIPT_ARCHIVE_QUOTA",
    "trustedDeclarationQuotaError": "ERR_AUTOJS6_TYPESCRIPT_COMPILER_UNAVAILABLE",
    "admissionPoint": "before-worker-handle-claim-and-framing"
  },
  "transportCeiling": {
    "authority": "legacy-zip-validation-and-private-staging-only",
    "maximumArchiveFiles": 4096,
    "maximumArchiveContainerBytes": 67108864,
    "maximumArchiveExpandedBytes": 67108864,
    "maximumSingleFileBytes": 8388608,
    "privateFileBackedMaximumFiles": 4607,
    "privateFileBackedMaximumTotalBytes": 75497472,
    "testOnlyWorkerQuotaRevision": 2147483647,
    "testOnlySelectionAuthority": "trusted-debug-or-evidence-host-only",
    "promotesFormalSchema": false,
    "promotesOrdinaryQuota": false
  },
  "failurePolicy": {
    "outerMissingOrWrongType": "ERR_AUTOJS6_TYPESCRIPT_INVALID_REQUEST",
    "outerUnknownSchemaOrProfile": "ERR_AUTOJS6_TYPESCRIPT_CONTRACT_MISMATCH",
    "schemaRevisionMismatch": "ERR_AUTOJS6_TYPESCRIPT_CONTRACT_MISMATCH",
    "archiveOrManifestHashMismatch": "ERR_AUTOJS6_TYPESCRIPT_ARCHIVE_INTEGRITY",
    "payloadInventoryMismatch": "ERR_AUTOJS6_TYPESCRIPT_ARCHIVE_INTEGRITY",
    "callerDeclarationPath": "ERR_AUTOJS6_TYPESCRIPT_ARCHIVE_PATH",
    "unknownOrMissingField": "fail-closed",
    "fdOwnershipTransferred": false,
    "archiveStagingStarted": false,
    "workerDispatchStarted": false,
    "callerOutputBytes": 0,
    "automaticRetryAllowed": false
  },
  "promotionState": {
    "compilerAvailable": false,
    "projectCompilation": false,
    "semanticDiagnostics": false,
    "sourceMapV3": false,
    "nodeRuntimeRequired": false,
    "nodeRevisionTwoEndToEndChanged": false,
    "deviceEvidenceRefreshed": false
  }
