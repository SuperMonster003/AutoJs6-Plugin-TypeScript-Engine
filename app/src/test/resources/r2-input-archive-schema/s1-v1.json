      "packageMetadata": true,
      "packageTargets": "v1",
      "exactConditionalKeys": [
        "config",
        "packageMetadata",
        "packageTargets"
      ]
    },
    {
      "id": "node-r1-none",
      "profile": "node",
      "profileRevision": 1,
      "configKind": "none",
