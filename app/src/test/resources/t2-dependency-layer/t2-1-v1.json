    "callerInventoryIncluded": false,
    "ordinaryCallerQuotaCharged": false,
    "workerFramedBeforeT2_2": false
  },
  "limits": {
    "maximumFiles": 8192,
    "maximumSingleFileBytes": 8388608,
    "maximumTotalBytes": 67108864,
    "maximumLockfileBytes": 8388608,
    "maximumPathBytes": 1572864,
    "maximumCombinedArchiveFiles": 12289,
    "maximumCombinedArchiveContainerBytes": 146800640,
    "maximumCombinedArchiveExpandedBytes": 138412032
  },
  "identity": {
    "priority": [
      "package-lock",
      "pnpm-lock",
      "content"
