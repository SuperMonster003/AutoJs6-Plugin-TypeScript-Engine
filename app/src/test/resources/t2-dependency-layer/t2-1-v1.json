    "packageLockPath": "dependencies/lockfiles/package-lock.json",
    "pnpmLockPath": "dependencies/lockfiles/pnpm-lock.yaml",
    "contentFallback": "exact-inventory-fingerprint",
    "inventoryAlwaysBound": true,
    "cacheKeyIncludes": [
