  "cases": [
    {
      "name": "dayjs",
      "sourceLines": [
        "import dayjs from \"dayjs\";",
        "export const result: string = dayjs(\"2020-02-03\").format(\"YYYY-MM-DD\");"
      ],
      "expected": "2020-02-03",
      "rhino": {
        "runtime": "execute",
        "entry": "dayjs.min.js"
      },
      "node": {
        "runtime": "execute",
        "entry": "dayjs.min.js"
      },
      "boundary": "Bundled declarations and a CommonJS main entry work in both profiles.",
      "workaround": "None."
    },
    {
      "name": "lodash",
      "sourceLines": [
        "import lodash from \"lodash\";",
        "export const result: number[][] = lodash.chunk([1, 2, 3], 2);"
      ],
      "expected": [[1, 2], [3]],
      "rhino": {
        "runtime": "execute",
        "entry": "lodash.js"
      },
      "node": {
        "runtime": "execute",
        "entry": "lodash.js"
      },
      "boundary": "The runtime package is CommonJS and does not bundle declarations.",
      "workaround": "Install @types/lodash; without it strict compilation reports TS7016."
    },
    {
      "name": "zod",
      "sourceLines": [
        "import { z } from \"zod\";",
        "export const result: string = z.string().min(2).parse(\"ok\");"
      ],
      "expected": "ok",
      "rhino": {
        "runtime": "execute",
        "entry": "index.cjs"
      },
      "node": {
        "runtime": "execute",
        "entry": "index.js"
      },
      "boundary": "The exports map supplies independent require/import entries and .d.cts types.",
      "workaround": "None."
    },
    {
      "name": "uuid",
      "sourceLines": [
        "import { validate, version } from \"uuid\";",
        "const candidate = \"6ec0bd7f-11c0-43da-975e-2a8ad9ebae0b\";",
        "export const result: boolean = validate(candidate) && version(candidate) === 4;"
      ],
      "expected": true,
      "rhino": {
        "runtime": "stable-error",
        "errorCode": "ERR_AUTOJS6_TYPESCRIPT_RHINO_ESM_ONLY_DEPENDENCY"
      },
      "node": {
        "runtime": "execute",
        "entry": "dist-node/index.js"
      },
      "boundary": "Version 13 publishes only ESM runtime entries.",
      "workaround": "Use the Node profile."
    },
    {
      "name": "nanoid",
      "sourceLines": [
        "import { nanoid } from \"nanoid\";",
