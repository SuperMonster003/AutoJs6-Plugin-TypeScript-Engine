<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hasCode="true"
        android:icon="@mipmap/ic_icon_studio_application"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:roundIcon="@mipmap/ic_icon_studio_application">

        <meta-data android:name="org.autojs.plugin.WAKE_ACTIVITY" android:value="io.github.supermonster003.autojs6.plugin.typescript.WakeActivity" />
        <activity
            android:name="io.github.supermonster003.autojs6.plugin.typescript.WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="16384" />

        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <service
            android:name=".TypeScriptPluginInfoService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">

            <meta-data
                android:name="requiresHostVersion"
                android:value="${requiredHostVersion}" />

            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="typescript" />
            </intent-filter>
        </service>

        <service
            android:name=".TypeScriptCompilerPluginService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":typescript_compiler">

            <meta-data
                android:name="requiresHostVersion"
                android:value="${requiredHostVersion}" />

            <intent-filter>
                <action android:name="org.autojs.plugin.typescript.COMPILER" />
                <category android:name="typescript" />
            </intent-filter>
        </service>

        <!-- TypeScript parser contract v1: a separate Binder surface in the compiler process. -->
        <service
            android:name=".TypeScriptParserPluginService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":typescript_compiler">

            <intent-filter>
                <action android:name="org.autojs.plugin.typescript.PARSER" />
                <category android:name="typescript" />
            </intent-filter>
        </service>

        <service
            android:name=".R2CompilerProcessSupervisorJobService"
            android:directBootAware="false"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:process=":typescript_supervisor" />

        <service
            android:name=".R2CompilerProcessSupervisorService"
            android:directBootAware="false"
            android:exported="false"
            android:process=":typescript_supervisor" />

    </application>

</manifest>
