<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <queries>
        <package android:name="io.github.supermonster003.autojs6.plugin.typescript" />
    </queries>

    <instrumentation
        android:name=".R2PublicPreviewInstrumentation"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:label="External UID public R2 preview"
        android:targetPackage="io.github.supermonster003.autojs6.plugin.typescript.publicpreview" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="TypeScript Public R2 Preview"
        android:testOnly="true"
        tools:ignore="DataExtractionRules,MissingApplicationIcon" />

</manifest>
