    "transactionPolicies": {
      "getContractVersion": "no file descriptors",
      "getContractHash": "no file descriptors",
      "getCompilerInfo": "no file descriptors",
      "prewarm": "reject any file descriptor",
      "startCompilation": "exactly two top-level ParcelFileDescriptor parameters; reject file descriptors embedded in request metadata",
      "cancelCompilation": "reject any file descriptor"
    },
    "inputRequirements": [
      "seekable",
      "readable",
      "regular staging file",
      "not a pipe, socket, or directory"
    ],
    "outputRequirements": [
      "seekable",
      "writable",
      "truncatable",
      "regular staging file",
      "not a pipe, socket, or directory",
      "different backing file from input"
    ],
    "ownership": [
      "caller owns and closes its input and output descriptor references",
      "Binder gives the service independent transported descriptor references",
      "caller may close its references after startCompilation returns but must not read or reuse output before a terminal callback",
      "service closes both received references on admission rejection, success, failure, timeout, cancellation, callback death, and service destruction",
      "R1 rejection closes both service references before returning the ticket and sends zero callbacks",
      "accepted work truncates output before compilation and commits a fully validated archive before fsync, seek-to-zero, close, and terminal callback",
      "cancel, timeout, internal failure, and transport failure make a best effort to truncate output before close and callback",
      "service or callback Binder death causes the surviving side to release all owned descriptors and staging files"
    ],
    "terminalCallbackRule": "accepted work with both Binder peers alive sends exactly one terminal callback after service-side output close; admission rejection sends zero callbacks"
  }
