    "rawTransportRules": [
      "prewarm and cancelCompilation reject any file descriptor before Bundle materialization",
      "startCompilation inspects only its first typed request Bundle for embedded file descriptors",
      "startCompilation must not confuse the following input/output ParcelFileDescriptor parameters with request metadata",
